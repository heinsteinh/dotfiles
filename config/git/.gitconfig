[core]
    editor = vim
    excludesfile = ~/.gitignore_global
	pager = less -FRSX

[include]
    path = ~/.gitconfig.local


[init]
    defaultBranch = main

[push]
    default = current

[pull]
    rebase = false

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    lg = log --oneline --graph --decorate
[merge]
	tool = nvimdiff
[mergetool]
	prompt = false
	keepBackup = false
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[user]
	email = heinsteinh@gmail.com
	name = Heinstein F
